DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/artistheat_dev?schema=artistheat"

PORT=4100
# Comma-separated list of origins allowed to call this API from a browser
# (the Next.js frontend's dev/prod URLs).
CORS_ORIGINS=http://localhost:3000

# Used to sign admin session JWTs -- generate a real random value for
# anything beyond local dev, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-dev-only
JWT_EXPIRES_IN=7d

# Used only by `npm run seed:admin`.
SEED_ADMIN_EMAIL=admin@artistheat.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin

# Used to sign admin image uploads (browser uploads directly to Cloudinary;
# the API secret never leaves this server). Values from the Cloudinary
# dashboard's Access Keys page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dashboard analytics -- a Google Cloud service account with Viewer access
# on the GA4 property and the Search Console property. The private key
# comes from the service account's downloaded JSON key (keep the literal
# \n sequences from the JSON, don't turn them into real newlines).
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Domain-authority-style stats from Moz's API (free tier: 50 rows/month --
# results are cached in seo_stats_cache and only refreshed once a day, see
# src/routes/analytics.ts). MOZ_API_TOKEN is the base64 access-ID:secret-key
# pair Moz issues, used as-is in the Basic auth header.
SEO_STATS_DOMAIN=
MOZ_API_TOKEN=

# Newsletter (src/routes/newsletter.ts) -- bulk-sends via Gmail SMTP
# (nodemailer), one send per recipient (not one email with everyone BCC'd --
# that wouldn't support per-recipient unsubscribe links or per-recipient
# failure isolation). EMAIL_PASSWORD must be a Gmail App Password, not the
# account's real password. Same account/credential this project's sibling,
# Server808, already uses for its own notification emails -- see
# Server808/utils/email.js. TEST_EMAIL is where `isTest: true` sends go
# instead of the real subscriber list. FRONTEND_URL builds the unsubscribe
# link and the email's "Read More" CTA -- the Next.js frontend's own
# canonical URL (SITE_URL in ArtistHeat/src/lib/site.ts) isn't reachable
# from here, so this is ServerHeat's own copy of it.
EMAIL_USER=
EMAIL_PASSWORD=
TEST_EMAIL=
FRONTEND_URL=http://localhost:3000
