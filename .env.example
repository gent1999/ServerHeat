DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/artistheat_dev?schema=artistheat"

PORT=4100
# Comma-separated list of origins allowed to call this API from a browser
# (the Next.js frontend's dev/prod URLs).
CORS_ORIGINS=http://localhost:3000

# Used to sign admin session JWTs -- generate a real random value for
# anything beyond local dev, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-dev-only
JWT_EXPIRES_IN=7d

# Used only by `npm run seed:admin`.
SEED_ADMIN_EMAIL=admin@artistheat.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin

# Used to sign admin image uploads (browser uploads directly to Cloudinary;
# the API secret never leaves this server). Values from the Cloudinary
# dashboard's Access Keys page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dashboard analytics -- a Google Cloud service account with Viewer access
# on the GA4 property and the Search Console property. The private key
# comes from the service account's downloaded JSON key (keep the literal
# \n sequences from the JSON, don't turn them into real newlines).
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
