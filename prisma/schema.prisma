generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  published

  @@map("article_status")
}

// Editorial classification layered on top of the existing (legacy)
// Category system -- lets an article be tagged as e.g. "Music" + "Interview"
// without touching how categories work. An article can have zero, one, or
// several (see ArticleEditorialType below); legacy articles simply have
// none and are never backfilled.
enum EditorialType {
  INTERVIEW
  ARTIST_SPOTLIGHT
  MUSIC_REVIEW
  NEW_RELEASE
  MUSIC_NEWS
  FASHION
  STREETWEAR
  BRAND_SPOTLIGHT
  CULTURE
  OTHER

  @@map("editorial_type")
}

model Author {
  id        BigInt   @id @default(autoincrement())
  name      String
  slug      String   @unique
  email     String?
  bio       String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  articles   Article[]
  adminUsers AdminUser[]

  @@map("authors")
}

model AdminUser {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("admin")
  authorId     BigInt?  @map("author_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  author            Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedArticles Article[] @relation("ArticlePublisher")

  @@map("admin_users")
}

model Category {
  id          BigInt  @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  articleCategories ArticleCategory[]

  @@map("categories")
}

model Tag {
  id   BigInt @id @default(autoincrement())
  name String
  slug String @unique

  articleTags ArticleTag[]

  @@map("tags")
}

model Media {
  id        BigInt   @id @default(autoincrement())
  sourceUrl String   @map("source_url")
  localPath String?  @map("local_path")
  altText   String?  @map("alt_text")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  articles  Article[]
  galleryOf ArticleGalleryImage[]

  @@map("media")
}

model Article {
  id                 BigInt        @id @default(autoincrement())
  title              String
  slug               String        @unique
  excerpt            String?
  content            String
  status             ArticleStatus @default(published)
  authorId           BigInt?       @map("author_id")
  featuredImageId    BigInt?       @map("featured_image_id")
  publishedAt        DateTime?     @map("published_at") @db.Timestamptz(6)
  updatedAt          DateTime?     @map("updated_at") @db.Timestamptz(6)
  seoTitle           String?       @map("seo_title")
  seoDescription     String?       @map("seo_description")
  seoFocusKeyword    String?       @map("seo_focus_keyword")
  canonicalUrl       String?       @map("canonical_url")
  ogImageUrl         String?       @map("og_image_url")
  spotifyUrl         String?       @map("spotify_url")
  soundcloudUrl      String?       @map("soundcloud_url")
  youtubeUrl         String?       @map("youtube_url")
  isFeatured         Boolean       @default(false) @map("is_featured")
  featuredOrder      Int?          @map("featured_order")
  isTrending         Boolean       @default(false) @map("is_trending")
  isEditorsPick      Boolean       @default(false) @map("is_editors_pick")
  publishedByAdminId BigInt?       @map("published_by_admin_id")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  author                Author?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featuredImage         Media?                 @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  publishedByAdmin      AdminUser?             @relation("ArticlePublisher", fields: [publishedByAdminId], references: [id], onDelete: SetNull)
  articleCategories     ArticleCategory[]
  articleTags           ArticleTag[]
  articleEditorialTypes ArticleEditorialType[]
  galleryImages         ArticleGalleryImage[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("articles")
}

// Many-to-many, mirroring ArticleCategory -- an article can carry several
// editorial types at once (e.g. Interview + Artist Spotlight), same as it
// can carry several categories. No isPrimary here: editorial-type badges
// just render all of them, nothing depends on picking one as "the" type.
model ArticleEditorialType {
  articleId     BigInt        @map("article_id")
  editorialType EditorialType @map("editorial_type")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, editorialType])
  @@index([editorialType])
  @@map("article_editorial_types")
}

// Up to 3 extra images shown at the bottom of an article, separate from
// the featured/cover image. Capped at 3 by application logic (POST/PUT
// /api/articles), not by the schema, so the limit can change later
// without another migration.
model ArticleGalleryImage {
  articleId BigInt @map("article_id")
  mediaId   BigInt @map("media_id")
  position  Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, mediaId])
  @@index([articleId])
  @@map("article_gallery_images")
}

model ArticleCategory {
  articleId  BigInt  @map("article_id")
  categoryId BigInt  @map("category_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
  @@map("article_categories")
}

model ArticleTag {
  articleId BigInt @map("article_id")
  tagId     BigInt @map("tag_id")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model Redirect {
  id         BigInt   @id @default(autoincrement())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(301) @map("status_code") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("redirects")
}

// Cached Moz domain-authority-style metrics. The free Moz API tier only
// allows 50 rows/month, so we refresh this on a timer (see analytics.ts)
// instead of calling Moz on every dashboard load.
model SeoStatsCache {
  id                 BigInt   @id @default(autoincrement())
  domain             String   @unique
  domainAuthority    Float?   @map("domain_authority")
  pageAuthority      Float?   @map("page_authority")
  spamScore          Float?   @map("spam_score")
  linkingRootDomains Int?     @map("linking_root_domains")
  externalBacklinks  Int?     @map("external_backlinks")
  fetchedAt          DateTime @map("fetched_at") @db.Timestamptz(6)

  @@map("seo_stats_cache")
}

// Single-row table for site-wide (not per-article) settings -- currently
// just the homepage Spotify playlist embed, but a natural home for any
// future sitewide config without another schema change.
model SiteSettings {
  id                         Int      @id @default(1)
  homepageSpotifyPlaylistUrl String?  @map("homepage_spotify_playlist_url")
  adsEnabled                 Boolean  @default(false) @map("ads_enabled")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

// Native banner ads shown in the homepage's left ad column (see AdColumn.tsx
// and routes/ads.ts). isActive is a per-banner show/hide toggle, independent
// of SiteSettings.adsEnabled which turns the whole column on/off site-wide.
model AdBanner {
  id           BigInt   @id @default(autoincrement())
  title        String?
  imageUrl     String   @map("image_url")
  linkUrl      String   @map("link_url")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ad_banners")
}

// Email newsletter subscriber list -- ported from Cry808/Server808's
// working system. isActive=false on unsubscribe rather than deleting the
// row, so re-subscribing the same email reactivates it instead of hitting
// the unique constraint (see POST /subscribe in routes/newsletter.ts).
model NewsletterSubscriber {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  source       String?
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(6)

  @@map("newsletter_subscribers")
}

// One row per newsletter campaign actually sent (including test sends) --
// recipientCount is the number that *succeeded*, not the number attempted.
model NewsletterSend {
  id             BigInt   @id @default(autoincrement())
  subject        String
  imageUrl       String?  @map("image_url")
  introText      String?  @map("intro_text")
  recipientCount Int      @default(0) @map("recipient_count")
  isTest         Boolean  @default(false) @map("is_test")
  sentAt         DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@map("newsletter_sends")
}

// ---------------------------------------------------------------------------
// Finance -- a simple revenue/expense command center for this one site.
// Single-tenant by design: no site/tenant column, this database only ever
// serves ArtistHeat's own finances.

enum FeeType {
  none
  percentage
  fixed

  @@map("fee_type")
}

enum SourceStatus {
  active
  pending
  inactive

  @@map("source_status")
}

enum RevenuePaymentStatus {
  pending
  paid
  cancelled

  @@map("revenue_payment_status")
}

enum PayoutStatus {
  not_ready
  ready_for_payout
  paid_out

  @@map("payout_status")
}

enum ExpenseCategory {
  domain
  hosting
  software
  ads
  other

  @@map("expense_category")
}

enum BillingCycle {
  one_time
  monthly
  yearly

  @@map("billing_cycle")
}

enum ExpensePaymentStatus {
  paid
  pending

  @@map("expense_payment_status")
}

model RevenueSource {
  id              BigInt       @id @default(autoincrement())
  name            String
  type            String       @default("manual")
  defaultGross    Decimal      @default(0) @map("default_gross") @db.Decimal(12, 2)
  feeType         FeeType      @default(none) @map("fee_type")
  feeValue        Decimal      @default(0) @map("fee_value") @db.Decimal(12, 2)
  payoutThreshold Decimal      @default(0) @map("payout_threshold") @db.Decimal(12, 2)
  status          SourceStatus @default(active)
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries RevenueEntry[]
  payouts Payout[]

  @@map("revenue_sources")
}

model RevenueEntry {
  id            BigInt               @id @default(autoincrement())
  date          DateTime             @default(now()) @db.Date
  sourceId      BigInt?              @map("source_id")
  articleTitle  String?              @map("article_title")
  articleUrl    String?              @map("article_url")
  clientName    String?              @map("client_name")
  grossAmount   Decimal              @map("gross_amount") @db.Decimal(12, 2)
  feeAmount     Decimal              @default(0) @map("fee_amount") @db.Decimal(12, 2)
  netAmount     Decimal              @default(0) @map("net_amount") @db.Decimal(12, 2)
  paymentStatus RevenuePaymentStatus @default(pending) @map("payment_status")
  payoutStatus  PayoutStatus         @default(not_ready) @map("payout_status")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source RevenueSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([date])
  @@map("revenue_entries")
}

model Payout {
  id        BigInt   @id @default(autoincrement())
  sourceId  BigInt?  @map("source_id")
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now()) @db.Date
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  source RevenueSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@map("payouts")
}

model Expense {
  id            BigInt               @id @default(autoincrement())
  name          String
  category      ExpenseCategory      @default(other)
  amount        Decimal              @db.Decimal(12, 2)
  billingCycle  BillingCycle         @default(one_time) @map("billing_cycle")
  vendor        String?
  renewalDate   DateTime?            @map("renewal_date") @db.Date
  paymentStatus ExpensePaymentStatus @default(paid) @map("payment_status")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([renewalDate])
  @@map("expenses")
}
